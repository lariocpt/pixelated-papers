'--json[]' \
'--bench[Live render timings, variant cache stats, RSS/fd (R8 proof)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(export)
_arguments "${_arguments_options[@]}" : \
'--pixel=[]:PIXEL:_default' \
'--placement=[]:PLACEMENT:_default' \
'--bg=[]:BG:_default' \
'--gutter=[]:GUTTER:_default' \
'-o+[]:OUT:_files' \
'--out=[]:OUT:_files' \
