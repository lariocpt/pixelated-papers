'--help[Print help]' \
':id:_default' \
':size:_default' \
&& ret=0
;;
(optimize)
_arguments "${_arguments_options[@]}" : \
'--all[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(daemon)
