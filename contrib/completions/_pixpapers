&& ret=0
;;
(optimize)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_pixpapers_commands] )) ||
_pixpapers_commands() {
    local commands; commands=(
'add:Add wallpaper(s) to the library (original stored optimized)' \
'list:List the library' \
'remove:Remove a wallpaper (entry + variants)' \
'set:Apply a wallpaper now (starts the daemon if needed)' \
'pixel:Set the pixel look for one wallpaper\: 8|16|32|64|128|normal' \
'placement:Set placement for one wallpaper\: fit|cover-gutter|cover-crop|stretch' \
'bg:Set border/gutter color (#rrggbb) for one wallpaper' \
'gutter:Set gutter width in px (cover-gutter) for one wallpaper' \
'default:Change defaults for new wallpapers / unset entries' \
'enable:Force pixelation on for everything (default)' \
'disable:Turn pixelation off (originals only, placement unchanged)' \
'cycle:Rotate to the next wallpaper (by N, default 1)' \
'status:Daemon status' \
'export:Offline render to a PNG (no daemon needed)\: e.g. 1920x1080' \
'optimize:Re-run original optimization over the library' \
'daemon:Run the wallpaper daemon (foreground)' \
'stop:Ask a running daemon to stop' \
'completions:Emit a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'pixpapers commands' commands "$@"
}
